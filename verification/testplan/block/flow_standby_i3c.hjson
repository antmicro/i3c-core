{
  name: flow_standby_i3c
  testpoints:
  [
    {
      name: rx
      desc:
        '''
        Tests basic operation of the flow_standby_i3c module. The test
        instantiates two tasks serving as BFMs for RX and TX queues.
        Then it simulates bus start condition followed by data reception
        ended by bus stop condition.
        '''
      tests: ["rx"]
      tags: ["flow_standby_i3c"]
    }
    {
      name: flow_standby_i2c
      desc:
        '''
        Tests basic operation of the flow_standby_i2c module.
        '''
      tests: ["detect_data",
              "reset",
              "detect_nack",
              "detect_restart",
              "detect_start",
              "detect_stop"]
      tags: ["flow_standby_i2c"]
    }
    {
      name: i3c_target_fsm
      desc:
        '''
        Tests basic operation of the i3c_target_fsm module.
        '''
      tests: ["i3c_target_fsm"]
      tags: ["flow_standby_i3c"]
    }
  ]
}
