{
  name: CSR access check
  testpoints:
  [
    {
      name: Test CSR accesses
      desc:
        '''
        Walk over all CSRs, write random value using AHB/AXI, read it back,
        and compare with expected output.
        '''
      tests: [
        "dat_csr_access",
        "dct_csr_access",
        "base_csr_access",
        "pio_csr_access",
        "ec_sec_fw_rec_csr_access",
        "ec_stdby_ctrl_mode_csr_access",
        "ec_tti_csr_access",
        "ec_soc_mgmt_csr_access",
        "ec_contrl_config_csr_access",
        "ec_csr_access"
      ]
      tags: ["top"]
    }
    {
      name: AXI burst accesses
      desc:
        '''
        Walk over all CSRs, issue randomized burst read and write transactions
        and compare with expected output.
        '''
      tests: [
        "test_basic_burst_write",
        "test_basic_burst_read"
      ]
      tags: ["top"]
    }
  ]
}
